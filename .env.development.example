# SaaS Chatbot Template - Development Environment Configuration
# Copy this file to .env for local development

# =============================================================================
# CORE APPLICATION SETTINGS (DEVELOPMENT)
# =============================================================================

NODE_ENV=development
PORT=5000
HOST=localhost

# Development logging (more verbose)
LOG_LEVEL=debug

# Development performance thresholds (more lenient)
SLOW_REQUEST_THRESHOLD=5000
CRITICAL_REQUEST_THRESHOLD=15000
MEMORY_THRESHOLD=200000000

# =============================================================================
# DATABASE CONFIGURATION (OPTIONAL IN DEV)
# =============================================================================

# Development database URL (optional - uses in-memory storage if not provided)
# DATABASE_URL=postgresql://username:password@localhost:5432/chatbot_dev

# =============================================================================
# SESSION CONFIGURATION (OPTIONAL IN DEV)
# =============================================================================

# Session secret (optional in development - auto-generated if not provided)
# SESSION_SECRET=your-development-session-secret-at-least-32-characters

# =============================================================================
# AI SERVICE PROVIDERS (OPTIONAL IN DEV)
# =============================================================================

# Primary AI service (optional in development)
# GEMINI_API_KEY=your-development-gemini-api-key

# Backup AI service (optional in development)
# OPENAI_API_KEY=sk-your-development-openai-api-key

# =============================================================================
# OLLAMA CONFIGURATION (DEFAULT VALUES)
# =============================================================================

# Local Ollama server (defaults provided)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# =============================================================================
# IMAGE SERVICE PROVIDERS (OPTIONAL)
# =============================================================================

# PEXELS_API_KEY=your-development-pexels-api-key
# PIXABAY_API_KEY=your-development-pixabay-api-key

# =============================================================================
# VIDEO SERVICE PROVIDERS (OPTIONAL)
# =============================================================================

# YOUTUBE_API_KEY=your-development-youtube-api-key

# =============================================================================
# SOCIAL MEDIA INTEGRATION (OPTIONAL)
# =============================================================================

# INSTAGRAM_CLIENT_ID=your-development-instagram-client-id
# INSTAGRAM_CLIENT_SECRET=your-development-instagram-client-secret
REDIRECT_URI=http://localhost:5000/auth/instagram/callback

FACEBOOK_API_VERSION=v18.0

# =============================================================================
# URL CONFIGURATION (DEVELOPMENT URLS)
# =============================================================================

FRONTEND_URL=http://localhost:5000
BACKEND_URL=http://localhost:5000

# =============================================================================
# ADMIN CONFIGURATION (DEVELOPMENT ONLY)
# =============================================================================

# Default admin credentials for development (auto-created)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@localhost.dev

# =============================================================================
# CLIENT-SIDE CONFIGURATION (DEVELOPMENT)
# =============================================================================

VITE_API_BASE_URL=http://localhost:5000
VITE_APP_NAME=SaaS ChatBot AI (Dev)
VITE_APP_VERSION=1.0.0-dev
VITE_ENVIRONMENT=development

# Development feature flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_MOCK_DATA=true

# Development settings (enabled)
VITE_DEV_TOOLS=true
VITE_HOT_RELOAD=true

# Development monitoring (optional)
# VITE_SENTRY_DSN=https://your-dev-sentry-dsn@sentry.io/project-id

# =============================================================================
# ERROR MONITORING (OPTIONAL IN DEV)
# =============================================================================

# Sentry DSN for server-side error monitoring (optional in development)
# SENTRY_DSN=https://your-dev-sentry-dsn@sentry.io/project-id

# =============================================================================
# CDN CONFIGURATION (OPTIONAL IN DEV)
# =============================================================================

# CDN settings for development (usually disabled)
CDN_ENABLED=false
# CDN_BASE_URL=https://dev-cdn.example.com
# CDN_REGIONS=us-east-1

# Client-side CDN configuration
VITE_CDN_ENABLED=false
# VITE_CDN_BASE_URL=https://dev-cdn.example.com

# =============================================================================
# DEVELOPMENT NOTES
# =============================================================================

# 📝 Development Setup Notes:
# - Most environment variables are optional in development
# - Default values are provided for core functionality
# - AI services are optional but recommended for full feature testing
# - Database is optional (uses in-memory storage)
# - Session secret is auto-generated if not provided
# - Admin user is auto-created with default credentials
# - All external services (images, video, social) are optional
# - Error monitoring is optional but helpful for debugging